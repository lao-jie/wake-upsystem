PORT=3001
AI_API_KEY=

# 宝塔 MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=TB
DB_PASSWORD=你的数据库密码
DB_NAME=tb

# QQ 邮箱发验证码（授权码不是 QQ 登录密码）
SMTP_HOST=smtp.qq.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=你的QQ@qq.com
SMTP_PASS=QQ邮箱授权码
SMTP_FROM=你的QQ@qq.com
MAIL_FROM_NAME=老街网创

# 同一 IP 每天最多注册 1 次（1=开启 0=关闭）
REG_IP_LIMIT=1
